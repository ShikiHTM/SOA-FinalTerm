# Server
PORT=8003

# Database
ASSESSMENT_DB_HOST=localhost
ASSESSMENT_DB_PORT=5003
ASSESSMENT_DB_USER=assessment_service
ASSESSMENT_DB_PASSWORD=assessment_service_dev
ASSESSMENT_DB_NAME=assessment_db
ASSESSMENT_DB_SYNC_SCHEMA=true

# Security
INTERNAL_SERVICE_SECRET=local-dev-secret

# Services
GROUP_SERVICE_URL=http://localhost:8002

# S3 Storage
S3_REGION=ap-southeast-1
S3_BUCKET=lms-assessments
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRESIGN_EXPIRES_IN_SECONDS=900
S3_MAX_PDF_BYTES=20971520
S3_AUTO_CREATE_BUCKET=false

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
