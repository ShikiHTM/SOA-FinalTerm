# Server
PORT=8005

# Database
SUBMISSION_DB_HOST=localhost
SUBMISSION_DB_PORT=5005
SUBMISSION_DB_USER=submission_service
SUBMISSION_DB_PASSWORD=submission_service_dev
SUBMISSION_DB_NAME=submission_db
SUBMISSION_DB_SSLMODE=disable
SUBMISSION_DB_SYNC_SCHEMA=true

# Security
INTERNAL_SERVICE_SECRET=local-dev-secret

# Services
GROUP_SERVICE_URL=http://localhost:8002
ASSESSMENT_SERVICE_URL=http://localhost:8003
CONTEST_SERVICE_URL=http://localhost:8004

# Kafka
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_SUBMISSION_TOPIC=submission.submitted.v1
KAFKA_NOTIFICATION_TOPIC=notification.requested.v1
KAFKA_CONSUMER_GROUP=submission-service

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
