# Shared
INTERNAL_SERVICE_SECRET="local-dev-secret"
CORS_ALLOWED_ORIGINS="http://localhost:8080,http://127.0.0.1:8080"

# User Service
USER_DB_USER="user_service"
USER_DB_PASSWORD="user_service_dev"
USER_DB_NAME="user_db"
USER_DB_SYNC_SCHEMA="true"
JWT_SECRET="change-this-jwt-secret-in-production"
JWT_EXPIRES_IN_SECONDS="86400"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Group Service
GROUP_DB_USER="group_service"
GROUP_DB_PASSWORD="group_service_dev"
GROUP_DB_NAME="group_db"
GROUP_DB_SYNC_SCHEMA="true"

# Assessment Service
ASSESSMENT_DB_USER="assessment_service"
ASSESSMENT_DB_PASSWORD="assessment_service_dev"
ASSESSMENT_DB_NAME="assessment_db"
ASSESSMENT_DB_SYNC_SCHEMA="true"

# AWS S3 Storage
S3_REGION="ap-southeast-1"
S3_BUCKET="lms-assessments"
S3_ENDPOINT=""
S3_PUBLIC_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PRESIGN_EXPIRES_IN_SECONDS="900"
S3_MAX_PDF_BYTES="20971520"
S3_AUTO_CREATE_BUCKET="false"

# Notification Service
NOTIFICATION_DB_USER="notification"
NOTIFICATION_DB_PASSWORD="notification_dev"
NOTIFICATION_DB_NAME="notification_db"
KAFKA_ENABLED="false"
KAFKA_BROKERS=""
KAFKA_NOTIFICATION_TOPIC="notification.requested.v1"
